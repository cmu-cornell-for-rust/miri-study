Bootstrap: docker
From: ubuntu:25.04

%environment
    export DEBIAN_FRONTEND=noninteractive
    export PATH="/root/.cargo/bin:/usr/local/rust-built/bin:$PATH"
    export LD_LIBRARY_PATH="/usr/local/rust-built/lib:$LD_LIBRARY_PATH"

%files
    bootstrap.toml /opt/bootstrap.toml

%post
    export DEBIAN_FRONTEND=noninteractive

    # ── System packages ──────────────────────────────────────────────────────
    apt-get update && apt-get install -y \
        libunwind8 \
        libunwind-dev \
        build-essential \
        cmake \
        clang \
        clang-tidy \
        clang-format \
        ninja-build \
        curl \
        vim \
        pkg-config \
        libssl-dev \
        sudo \
        git \
        gdb \
        r-base \
        valgrind \
        elfutils \
        libdw-dev \
        libelf-dev \
        libboost-all-dev \
        linux-perf \
        python3 \
        && rm -rf /var/lib/apt/lists/*

    # ── Compiler alternatives ─────────────────────────────────────────────────
    update-alternatives --install /usr/bin/cc  cc  /usr/bin/clang   100
    update-alternatives --install /usr/bin/c++ c++ /usr/bin/clang++ 100

    # ── Bootstrap Rust (nightly-2026-03-12 as host toolchain) ────────────────
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- --default-toolchain nightly-2026-03-12 -y
    export PATH="/root/.cargo/bin:$PATH"

    # ── Clone the fork ────────────────────────────────────────────────
    git clone \
        --branch lazy-alloc \
        --single-branch \
        https://github.com/cmu-cornell-for-rust/rust.git \
        /opt/rust-built
        cd /opt/rust-built
        cp /opt/bootstrap.toml /opt/rust-built/bootstrap.toml

    # ── Build & install Rust ─────────────────────────────────────────────────
    ./x.py build && ./x.py install

    # ── Set it to the default toolchain ──────────────────────────────────────

    rustup toolchain link built /usr/local/rust-built
    rustup default built

    # ── Clean build artefacts to shrink image ────────────────────────────────
    rm -rf /opt/rust-built/built

%runscript
    exec "$@"

%labels
    Author      CMU-Cornell Rust
    BaseOS      ubuntu:25.04
    Toolchain   nightly-2026-03-12

%help
    Singularity container with:
      • Ubuntu 25.04 base + full C/C++ toolchain (clang as default cc/c++)
      • Rust nightly-2026-03-12 (host, via rustup)
      • CMU-Cornell rust built at stage 2, installed to
        /usr/local/rust-built
      • Miri (stage 1) installed alongside


    PATH inside the container includes /usr/local/rust-built/bin so the
    custom rustc/cargo/miri binaries shadow the host toolchain automatically.
